{
  "name": "astroscreen",
  "productName": "AstroScreen",
  "version": "2.0.0",
  "description": "Graba tu pantalla y haz capturas con estilo. Código abierto.",
  "main": "main.js",
  "author": "AstroSoftware <astrosoftware@users.noreply.github.com>",
  "homepage": "https://github.com/AstroSoftwareMoon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.astroscreen.app",
    "productName": "AstroScreen",
    "files": [
      "main.js",
      "preload.js",
      "astroscreen.png",
      "src/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AstroSoftwareMoon/AstroScreen.git"
  }
}